# Contact Form (Formspree or EmailJS)
# Option 1: Formspree (easiest) — create a form at https://formspree.io and paste your form ID
VITE_FORMSPREE_ENDPOINT=

# Option 2: EmailJS — create a service/template at https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional AI Chatbot backend endpoint (falls back to built-in client-side RAG engine if blank)
VITE_CHAT_API_URL=
