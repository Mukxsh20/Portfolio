{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/resume.pdf",
      "headers": [
        { "key": "Content-Disposition", "value": "inline; filename=\"Mukesh_Kumar_Chaurasia_Resume.pdf\"" }
      ]
    }
  ]
}
